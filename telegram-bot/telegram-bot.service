[Unit]
Description=Bot de Telegram para nodos de los SENSORES
Wants=network-online.target
After=network-online.target prometheus.service

[Service]
Type=simple
User=TOTO
WorkingDirectory=/home/TOTO/DGTIC-RedAislada/RED-SENSORES/bme280-esp32c3/telegram-bot
EnvironmentFile=/etc/telegram-bot/telegram-bot.env
Environment=PYTHONNOUSERSITE=1
ExecStart=/usr/bin/python3 /home/TOTO/DGTIC-RedAislada/RED-SENSORES/bme280-esp32c3/telegram-bot/bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
