# Copia este archivo a ".env" y llena tus valores reales.
# NUNCA subas el archivo ".env" (con el token real) al repositorio.

# Token que te da @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReemplazaEsto

# Tu chat_id (o varios separados por coma). Consiguelo hablando con
# @userinfobot en Telegram, o mandando un mensaje a tu bot y visitando
# https://api.telegram.org/bot<TU_TOKEN>/getUpdates
TELEGRAM_ALLOWED_CHAT_IDS=123456789

# URL de Prometheus (normalmente no hay que cambiarla si el bot corre
# en el mismo servidor).
PROMETHEUS_URL=http://localhost:9090

# Cada cuantos segundos revisa si algun nodo se cayo o se recupero, para
# avisar por Telegram a todos los TELEGRAM_ALLOWED_CHAT_IDS sin que nadie
# tenga que preguntar con /estado.
CHECK_INTERVAL_SEC=30
