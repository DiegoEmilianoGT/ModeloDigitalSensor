[Unit]
Description=Actualiza el dataset de sensores (ultimos 30 dias)
Wants=network-online.target
After=network-online.target prometheus.service

[Service]
Type=oneshot
User=TOTO
WorkingDirectory=/home/TOTO/DGTIC-RedAislada/RED-SENSORES/bme280-esp32c3/analisis
ExecStart=/usr/bin/python3 /home/TOTO/DGTIC-RedAislada/RED-SENSORES/bme280-esp32c3/analisis/dataset.py
